# Supabase — client tarafında kullanılır, güvenle public'e açık olabilir.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sunucu tarafı ONLY — asla NEXT_PUBLIC_ ile prefixlenmemeli, client'a sızdırılmamalı.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Supabase yönetim/CLI kişisel erişim anahtarı (proje bazlı değil).
SUPABASE_ACCESS_TOKEN=

# Admin paneline erişebilecek e-postalar (virgülle ayrılmış) — kullanıcı bazlı erişim.
ADMIN_EMAILS=

# Admin paneli tek-şifre girişi (paylaşılan parola). Sunucu tarafı ONLY.
ADMIN_PASS=

